# -> /etc/mysql/mariadb.conf.d/99-ccshareapp.cnf  (MariaDB)
#    or /etc/mysql/mysql.conf.d/99-ccshareapp.cnf (MySQL)
#
# Stock MariaDB wants ~400MB RSS. On a 1GB VM that leaves nothing for a 200MB
# heap plus nginx plus the OS. This trims it to roughly 150MB, which is ample
# for one table holding a handful of rows.

[mysqld]
bind-address = 127.0.0.1

innodb_buffer_pool_size = 64M
innodb_log_buffer_size  = 8M
performance_schema      = OFF
max_connections         = 10
key_buffer_size         = 8M
tmp_table_size          = 8M
max_heap_table_size     = 8M
table_open_cache        = 64

# Durability over throughput: this is a card vault, not an analytics store.
# Flush on every commit so a VM that dies mid-write loses nothing.
innodb_flush_log_at_trx_commit = 1
