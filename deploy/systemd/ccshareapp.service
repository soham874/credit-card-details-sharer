# -> /etc/systemd/system/ccshareapp.service
[Unit]
Description=Card Vault API
# The database is a managed HeatWave DB System reached over the VCN, so there is
# no local mysqld to order against — only the network.
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=ccshare
Group=ccshare
WorkingDirectory=/opt/ccshareapp

# DB_USER, DB_PASSWORD, CORS_ALLOWED_ORIGIN, SPRING_PROFILES_ACTIVE=prod.
# chmod 600, owned by root — the service reads it before dropping to ccshare.
EnvironmentFile=/etc/ccshareapp/env

# JVM flags per LLD §8.4. SerialGC over G1 deliberately: G1's bookkeeping is
# wasted overhead at this concurrency and costs RAM the box does not have.
ExecStart=/usr/bin/java \
    -Xmx200m -Xms100m -Xss256k \
    -XX:MaxMetaspaceSize=100m \
    -XX:+UseSerialGC \
    -XX:+ExitOnOutOfMemoryError \
    -jar /opt/ccshareapp/ccshareapp.jar

Restart=on-failure
RestartSec=5s

# Sandboxing. The service needs one TCP socket, one log directory, and nothing else.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/log/ccshareapp

# Hard ceiling above -Xmx to cover metaspace, thread stacks and native buffers.
# Without this an OOM takes the whole 1GB box down instead of just the service.
MemoryMax=450M

[Install]
WantedBy=multi-user.target
